# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# Local configuration (may contain credentials)
.env

# Databases: may contain REAL player names (personal data) -> never commit
*.db
*.sqlite
