# Copy this file to .env and adjust. Environment variables override .env values.

# SQLAlchemy database URL.
#   SQLite (default):  sqlite:///data/football.db
#   PostgreSQL:        postgresql+psycopg://user:password@localhost:5432/football
FP_DATABASE_URL=sqlite:///data/football.db

# Directory for cached raw HTML/CSV downloads.
FP_RAW_DATA_DIR=data/raw

# Logging level: DEBUG, INFO, WARNING, ERROR
FP_LOG_LEVEL=INFO

# Echo every SQL statement (useful for learning/debugging).
FP_SQL_ECHO=false

# Dashboard: start with player and team names anonymised (screenshots, public demos).
FP_ANONYMIZE=false
